# =============================================================================
# ForgeBoard Environment Variables
# Copy to .env.local for local development
# =============================================================================

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ForgeBoard
APP_VERSION=0.1.0

# Database (PostgreSQL)
DATABASE_URL=postgresql://forgeboard:forgeboard@localhost:5432/forgeboard?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
AUTH_SECRET=change-me-in-production-use-openssl-rand-base64-32
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000
SESSION_MAX_AGE_SECONDS=2592000
SESSION_UPDATE_AGE_SECONDS=86400

# OAuth (optional - add as needed)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# MFA
MFA_ISSUER=ForgeBoard

# AWS (for S3, etc.)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_ATTACHMENTS=forgeboard-attachments-dev
S3_BUCKET_BACKUPS=forgeboard-backups-dev

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@forgeboard.example

# Observability
OTEL_SERVICE_NAME=forgeboard
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Feature flags
FEATURE_FLAGS_API_ENABLED=false
